
# CORE
PORT=3004
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=secretsecretsecretsecretsecretsecretsecret
JWT_REFRESH_SECRET=secretsecretsecretsecretsecretsecretsecret

# TELEGRAM
# бот для тестового стенда
# TELEGRAM_BOT_TOKEN=8601453324:AAFodY-_70uDjZZi8SyFtIUNDkFpxgnJjoY
TELEGRAM_BOT_TOKEN=8234548291:AAH9ET0Q66DMcbc8MmXLGui9fKFqTGThjWE
MINI_APP_URL=t.me/bot_contest2_bot/apprandom
# telegram user ids админов через запятую
ADMIN_IDS=750482759

# DATABASE
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=tg_bot_db
DATABASE_SCHEMA=public

# Для миграций (опционально, но удобно)
TYPEORM_MIGRATIONS=dist/migrations/*.js
TYPEORM_MIGRATIONS_DIR=src/migrations

# Логи
# debug / info / warn / error / silent
LOG_LEVEL=debug
# true → включаем pino-pretty (только для dev!)
LOG_PRETTY=true
LOG_REDACT=req.headers.authorization,req.headers.cookie,req.body.password,req.body.token,req.body.accessToken,req.body.refreshToken

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# если есть, иначе пусто
REDIS_PASSWORD=
# обычно 0 для dev
REDIS_DB=7
BULL_PREFIX=new-v-telegram-bot-dev