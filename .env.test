# Конфиг ТОЛЬКО для интеграционных тестов.
# Указывает на ОТДЕЛЬНЫЙ тестовый стек из docker-compose.test.yml
# (порты 5433/6380), а не на твои dev-контейнеры (5432/6379).

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=tg_bot_test
DATABASE_SCHEMA=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
