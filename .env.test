# Конфиг ТОЛЬКО для интеграционных тестов.
# Указывает на ОТДЕЛЬНЫЙ тестовый стек из docker-compose.test.yml
# (порты 5433/6380), а не на твои dev-контейнеры (5432/6379).

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=tg_bot_test
DATABASE_SCHEMA=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Фиктивные значения ТОЛЬКО для bootstrap-smoke (bootstrap.int-spec.ts,
# AppModule.compile()). Нужны, чтобы validationSchema пропустила сборку.
# .compile() НЕ вызывает .init() → бот НЕ запускается, воркеры НЕ стартуют,
# в сеть/Telegram ничего не идёт. Реальные секреты здесь не требуются.
TELEGRAM_BOT_TOKEN=0000000000:TEST_DUMMY_BOOTSTRAP_ONLY
JWT_ACCESS_SECRET=test_access_secret_min_32_chars_len_ok_0
JWT_REFRESH_SECRET=test_refresh_secret_min_32_chars_len_ok0